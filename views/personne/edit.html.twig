{% extends "layout.html.twig" %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
<h1>{{ title }}</h1>


<form action="{{ url('personne_update', {'id': personne.id}) }}" method="POST"></form>
<input type="hidden" name="csrf_token" value="{{ csrf_token }}">
<label for="nom">Nom du personne:</label>
<div class="row">
    <div class="col">
        <input type="text" id="nom" class="form-control" name="nom" value="{{ personne.lastname }}" required>
    </div>
    <div class="col">
        <button type="submit" class="btn btn-primary">Mettre à jour</button>
    </div>
</div>
</form>
<div class="mt-3">
    <a href="{{ url('personne_index') }}" class="btn btn-success">Retour à la liste</a>
    <a href="{{ url('personne_show', {'id': personne.id}) }}" class="btn btn-secondary">Voir</a>
</div>
{% endblock %}