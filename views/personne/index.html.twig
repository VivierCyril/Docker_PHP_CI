{% extends "layout.html.twig" %}

{% block title %}{{ title }}{% endblock %}

{% block body %}

    <h1>{{ title }}</h1>
    <a href="{{ url('personne_create') }}" class="btn btn-primary mt-3">Créer une nouvelle personne</a>
    <table class="table table-striped mt-4">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nom</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for personne in personnes %}
            <tr>
                <td><a href="{{ url('personne_show', {'id': personne.id}) }}">{{ personne.id
                        }}</a></td>
                <td>{{ personne.lastname }}</td>
                <td>
                    <a href="{{ url('personne_edit', {'id': personne.id}) }}"
                        class="btn btn-secondary">Éditer</a>
                    <form action="{{ url('personne_delete', {'id': personne.id}) }}" method="POST"
                        style="display:inline;">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                        <button type="submit" onclick="return confirm('Êtes-vous sûr ?')"
                            class="btn btn-danger">Supprimer</button>
                    </form>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}